---
// Responsive product screenshot. Serves AVIF then WebP from public/brand/shots/
// (generated by scripts/optimize-shots.mjs) with an explicit aspect ratio so the
// image reserves its space and never causes layout shift.
//
// All current shots are 16:10. `name` is the friendly basename (e.g. "chat-hero").
interface Props {
  name: string;
  alt?: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  [key: string]: unknown;
}
const {
  name,
  alt = '',
  widths = [800, 1400, 2000],
  sizes = '(max-width: 900px) 92vw, 560px',
  class: className = '',
  loading = 'lazy',
  fetchpriority = 'auto',
  ...rest
} = Astro.props;

const base = '/brand/shots';
const srcset = (ext: string) =>
  widths.map((w) => `${base}/${name}-${w}.${ext} ${w}w`).join(', ');
// Fallback (no-srcset path) is derived from the configured widths, never hardcoded.
// so it always points at a variant the pipeline actually emitted. Pick a middle width.
const fallbackW = widths[Math.floor(widths.length / 2)] ?? widths[0];
---
<picture>
  <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
  <source type="image/webp" srcset={srcset('webp')} sizes={sizes} />
  <img
    src={`${base}/${name}-${fallbackW}.webp`}
    alt={alt}
    width="1600"
    height="1000"
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
    class={className}
    {...rest}
  />
</picture>
