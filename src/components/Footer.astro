// Footer ; shared across landing + legal pages.
// Layering (back → front): night sky (dark blue + faint dusk glow + stars, z-0) →
// WebGL fog canvas (animated FBM, pink/magenta, reveals the blue, z-0) →
// legibility scrim (z-1) → content (z-10).
const year = 2026;

// Stars sit behind the fog, biased to the upper (darker) sky.
const stars = [
