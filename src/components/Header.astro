---
// Site header — symbol + wordmark, link home, single CTA.
---
<header class="mx-auto flex max-w-6xl items-center justify-between px-6 py-6">
  <a href="/" class="flex items-center gap-3">
    <img src="/brand/symbol.png" alt="Concord Voice" width="36" height="36" class="h-9 w-auto" />
    <span class="display text-xl">Concord Voice</span>
  </a>
  <nav class="flex items-center gap-6">
    <span class="eyebrow text-mist hidden sm:inline">Coming Soon</span>
    <a
      href="https://www.kickstarter.com/projects/concord-mark/concord-voice"
      target="_blank"
      rel="noopener noreferrer"
      class="ks-btn !px-4 !py-2 !text-sm"
    >
      <img src="/brand/kickstarter-k-white.png" alt="" />
      <span>Kickstarter</span>
    </a>
  </nav>
</header>
