---
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/600.css';
import '@fontsource/source-sans-3/700.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Concord Voice — A Private Place for Your People',
  description = 'A private, voice-first community space for your people. Hang out in encrypted voice, video, and chat; make the space yours; host it yourself if you want.',
} = Astro.props;

// A few stars echoing the brand mark (the "Moon with Two Stars" symbol).
const stars = [
  { top: '12%', left: '16%', d: '0.2s' },
  { top: '20%', left: '82%', d: '1.1s' },
  { top: '34%', left: '44%', d: '2.0s' },
  { top: '48%', left: '8%', d: '0.7s' },
  { top: '60%', left: '90%', d: '1.6s' },
  { top: '72%', left: '28%', d: '2.4s' },
  { top: '83%', left: '66%', d: '0.4s' },
  { top: '28%', left: '62%', d: '3.0s' },
  { top: '8%', left: '50%', d: '1.4s' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0d0821" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <div class="aurora" aria-hidden="true"></div>
    <div class="starfield" aria-hidden="true">
      {stars.map((s) => <span class="star" style={`top:${s.top};left:${s.left};animation-delay:${s.d}`}></span>)}
    </div>
    <div class="grain" aria-hidden="true"></div>

    <div class="layer">
      <slot />
    </div>

    <!-- Tongue-in-cheek "no cookie banner": the absence IS the message.
         No cookie is ever set — dismissal is remembered in sessionStorage only
         (cleared when the tab closes), so the "zero cookies" claim stays literally true. -->
    <aside class="cookie-note" id="cookie-note" aria-label="Cookie notice">
      <p class="cookie-note__text">
        <strong>Looking for the cookie opt-out banner?</strong> It's not here — because
        there are <strong>zero cookies</strong> on this site. Nothing tracked, nothing
        stored, nothing to opt out of.
      </p>
      <div class="cookie-note__actions">
        <a class="cookie-note__link" href="/privacy-policy">Privacy policy &rarr;</a>
        <button
          type="button"
          class="cookie-note__ok"
          id="cookie-note-ok"
          aria-label="Dismiss this notice"
        >
          Nice 🍪
        </button>
      </div>
    </aside>

    <script>
      // Scroll-reveal — zero dependencies. Reduced motion handled in CSS.
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.15 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('in'));
      }

      // Tongue-in-cheek "no cookie banner" — dismissal lives in sessionStorage
      // (NOT a cookie; cleared when the tab closes), keeping the joke honest.
      const note = document.getElementById('cookie-note');
      if (note) {
        let dismissed = false;
        try {
          dismissed = sessionStorage.getItem('ccv-cookie-note') === '1';
        } catch {
          // sessionStorage unavailable (private mode / disabled) — show it anyway.
        }
        if (!dismissed) {
          window.setTimeout(() => note.classList.add('is-visible'), 900);
          document.getElementById('cookie-note-ok')?.addEventListener('click', () => {
            note.classList.remove('is-visible');
            try {
              sessionStorage.setItem('ccv-cookie-note', '1');
            } catch {
              // No-op: nothing to persist if storage is blocked.
            }
          });
        }
      }

      // Equal-height cards: level every .mkt-grid's boxes to its tallest, so card rows
      // read as uniform even when text lengths differ. Incomplete rows stay centered
      // (that's flexbox). No-op on pages without card grids (home/legal).
      const equalizeGrids = () => {
        document.querySelectorAll<HTMLElement>('.mkt-grid, .feat-grid').forEach((grid) => {
          const cards = Array.from(grid.children) as HTMLElement[];
          cards.forEach((c) => { c.style.minHeight = ''; });
          // Stacked in a single column (mobile) → leave natural heights. Detect via layout,
          // not window width, so it's reliable regardless of viewport-metric quirks.
          if (new Set(cards.map((c) => c.offsetLeft)).size <= 1) return;
          const max = cards.reduce((m, c) => Math.max(m, c.getBoundingClientRect().height), 0);
          cards.forEach((c) => { c.style.minHeight = `${Math.round(max)}px`; });
        });
      };
      const runEqualize = () => requestAnimationFrame(() => requestAnimationFrame(equalizeGrids));
      runEqualize();
      window.addEventListener('load', runEqualize);
      if (document.fonts?.ready) document.fonts.ready.then(runEqualize); // re-level after fonts swap in
      [300, 900].forEach((d) => window.setTimeout(runEqualize, d)); // catch late reflows (text wrap, images)
      let eqTimer: number | undefined;
      window.addEventListener('resize', () => { clearTimeout(eqTimer); eqTimer = window.setTimeout(runEqualize, 150); }, { passive: true });

      // Monthly / Yearly billing toggle for pricing blocks. No-op without a [data-bill] control.
      // A .tier__price carries data-m (monthly) / data-y (yearly) / data-save (% off) / data-per.
      const billButtons = document.querySelectorAll<HTMLElement>('[data-bill]');
      if (billButtons.length) {
        const setBilling = (mode: string) => {
          document.querySelectorAll<HTMLElement>('[data-bill]').forEach((b) => {
            const on = b.dataset.bill === mode;
            b.classList.toggle('is-active', on);
            b.setAttribute('aria-pressed', on ? 'true' : 'false');
          });
          document.querySelectorAll<HTMLElement>('.tier__price').forEach((p) => {
            const amt = p.querySelector<HTMLElement>('.tier__amt');
            const per = p.querySelector<HTMLElement>('.tier__per');
            const save = p.querySelector<HTMLElement>('.tier__save');
            const yearly = mode === 'yearly';
            const free = !p.dataset.y || p.dataset.m === '$0';
            if (amt) amt.textContent = free ? (p.dataset.m || '$0') : (yearly ? p.dataset.y! : p.dataset.m!);
            if (per) per.textContent = free ? (p.dataset.per || '') : (yearly ? '/year' : '/month');
            if (save) save.hidden = !(yearly && Number(p.dataset.save) > 0);
          });
        };
        billButtons.forEach((b) => b.addEventListener('click', () => setBilling(b.dataset.bill!)));
        setBilling('monthly');
      }
    </script>
  </body>
</html>
