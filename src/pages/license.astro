---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
// Verbatim copy of the canonical repo LICENSE (Concord Voice Source License 1.0).
// Imported as raw text and rendered preformatted so the wording and clause
// indentation are preserved EXACTLY — a license must never be reflowed or
// reinterpreted by a Markdown pass. In the canonical setup this is the same
// LICENSE file that lives at the repo root (synced), so it cannot drift.
import licenseText from '../legal/license.txt?raw';
---

<Layout
  title="License — Concord Voice"
  description="The Concord Voice Source License 1.0 (CVSL) — the source-available license governing the Concord Voice software, converting to AGPL-3.0-or-later on its Change Date."
>
  <Header />
  <main class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="display text-4xl sm:text-5xl">License</h1>
    <p class="mt-4 max-w-2xl text-mist">
      Concord Voice is <strong class="text-paper">source-available</strong> under the
      <strong class="text-paper">Concord Voice Source License 1.0</strong> — free for personal
      and non-profit use, with a commercial license required for for-profit and government use.
      It converts to <strong class="text-paper">AGPL-3.0-or-later</strong> on its Change Date.
      The full, unmodified text is below.
    </p>
    <pre class="legal-license">{licenseText}</pre>
    <p class="mt-12 text-sm text-mist">
      ← <a href="/" class="text-coral hover:text-gold">Back to home</a>
    </p>
  </main>
  <Footer />
</Layout>
