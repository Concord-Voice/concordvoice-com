---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import '@styles/marketing.css';

// Migrated from the Squarespace "Self-Hosting" page. Draft — gitignored + build-stripped.
const nav = [
  ['Features', '#features'], ['Requirements', '#requirements'], ['Deploy', '#deploy'],
  ['Costs', '#costs'], ['Ground Control', '#ground-control'], ['Licensing', '#licensing'], ['FAQ', '#faq'],
];
const promise = [
  { t: 'Every Feature. Unlocked.', d: 'Custom emoji, animated stickers, GIF banners, unlocked audio and video quality (no hosted-tier caps — your hardware is the only limit), unlimited file uploads — every capability is yours the moment you deploy. No license key required for personal and non-commercial use.' },
  { t: 'Your Infrastructure. Your Data.', d: "Your messages, files, and metadata never touch our servers. You choose where your data lives — your rack, your cloud, your closet. We have no access, no telemetry, no backdoor. That's not a policy. It's the architecture." },
  { t: 'No Strings. No Surprises.', d: 'The Concord Voice Source License (CVSL) permits personal and non-commercial self-hosting with zero restrictions. After four years, each version converts automatically to AGPL-3.0. Your deployment outlives our company by design.' },
];
const core = ['Unlimited servers and channels', 'Channel categories with drag-and-drop reordering', 'End-to-end encrypted messaging (AES-256-GCM + RSA-OAEP 4096-bit)', 'Real-time voice via WebRTC / mediasoup SFU', 'Video calling and screen sharing', 'All seven audio quality tiers', 'All video codecs (VP9 SVC, AV1, VP8, H.264)', 'Direct messages', 'Real-time presence', 'Full source code access for audit', 'Local accounts'];
const mach = ['Custom emoji uploads', 'Animated emoji', 'Custom stickers', 'GIF server photo and banner', 'Custom invite URL (with your own domain)', 'No file-upload size caps', 'Uncapped audio and video quality (hardware-limited)', 'Unlimited server file storage (your hardware is the only limit)', 'Custom themes and profile cards'];
const spec = [
  ['CPU', 'Dual-core 2 GHz', 'Quad-core 2.5 GHz+', 'Voice/video via mediasoup is CPU-bound — more cores = more concurrent calls'],
  ['RAM', '4 GB', '8 GB+', 'Go backend + Redis + PostgreSQL + mediasoup workers'],
  ['Storage', '20 GB', '50 GB+ SSD', 'Base install is small; storage scales with uploads and history'],
  ['Network', '10 Mbps symmetric', '100 Mbps+ symmetric', 'Voice/video scale with concurrent users — bandwidth is your ceiling'],
  ['OS', 'Linux (Ubuntu 22.04+, Debian 12+)', 'Ubuntu 24.04 LTS', 'macOS/Windows for dev; Linux for production'],
  ['Dependencies', 'Go 1.21+, Node 18+, PostgreSQL 15+, Redis 7+', 'Docker (handles it all)', 'Docker deployment configures every dependency automatically'],
];
const deploy = [
  { name: 'Docker', soon: false, desc: 'The fastest path from zero to running. Pull the image, set your environment variables, and launch.', code: ['docker pull concordvoice/concord:latest', 'docker compose up -d'], note: 'Includes the Go backend, mediasoup workers, PostgreSQL, and Redis — all pre-configured.', cta: 'View Docker Guide' },
  { name: 'Build from Source', soon: false, desc: 'Clone the repository and build everything yourself. Full control over every component.', code: ['git clone https://github.com/Concord-Voice/Concord_Voice.git', 'cd Concord-Voice && make build'], note: 'Requires Go 1.21+, Node 18+, and local PostgreSQL / Redis instances.', cta: 'View Build Guide' },
  { name: 'Cloud Template', soon: true, desc: 'Deploy to a cloud provider with a pre-built template. One-click templates for popular cloud providers are on the way.', code: [], note: 'Sign up to be notified when these are ready.', cta: 'Get Notified' },
];
const costs = [
  ['Small (10–50 members)', '5–15', '2 vCPU / 4 GB / 40 GB SSD', '$4–8/mo', 'A basic VPS handles this easily. Friends, small teams, gaming groups.'],
  ['Medium (50–200 members)', '15–60', '4 vCPU / 8 GB / 80 GB SSD', '$10–20/mo', 'Comfortable headroom for multiple active voice channels.'],
  ['Large (200–1,000 members)', '60–200', '8 vCPU / 16 GB / 160 GB SSD', '$25–50/mo', 'Dedicated-server territory. Consider splitting media and API.'],
  ['Very Large (1,000+ members)', '200+', 'Multiple servers / load-balanced', '$50–150+/mo', 'Multi-node deployment. Contact us for architecture guidance.'],
];
const gcIncluded = [
  { t: 'Concord Voice Network Sync', d: 'Connect your self-hosted server to the broader ecosystem — discoverability, cross-network presence, and the infrastructure to be part of something bigger than a standalone instance.' },
  { t: 'Public Directory Listing', d: 'Make your community discoverable in the Concord Public Directory so users can find and join. Toggle it on or off any time — visibility is always your choice.' },
  { t: 'Email Support (3 business days)', d: 'Official support from the team that built it. Submit a ticket, get a human response within 3 business days. Subscriber bug reports are prioritized.' },
];
const gcNot = ['Installation, deployment, or migration assistance', 'Server configuration or performance tuning', 'Same-day, next-day, or guaranteed SLA response', 'Phone or live-chat support', 'Dedicated account manager'];
const gcPricing = [['1 Year', '$120', '$120/yr', '—'], ['2 Years', '$204', '$102/yr', 'Save $36 (15% off)'], ['3 Years', '$270', '$90/yr', 'Save $90 (25% off)']];
const licFree = ['Deploy and run with all features', 'No license key or activation', 'No user limits', 'No feature restrictions', 'Full source-code access for audit', 'Use it forever'];
const licCommercial = ['Business or enterprise internal communications', 'Hosting Concord Voice servers as a paid service', 'Bundling Concord Voice into a commercial product', 'Any deployment supporting revenue-generating activity'];
const faq = [
  { q: 'Do I need a license to self-host?', a: 'For personal and non-commercial use — no. Deploy it, run it, use every feature. No license key, no activation, no restrictions. If you deploy Concord in a business or commercial context, the CVSL requires a commercial license. See our License page for details.' },
  { q: 'Are any features locked on self-hosted servers?', a: 'No. Self-hosting unlocks every feature with no hosted-tier caps — custom emoji, stickers, uncapped audio and video, file uploads — every feature unlocked, hardware-limited (you run your own media plane). We don\'t charge for feature flags on your hardware.' },
  { q: 'What do I lose without Ground Control?', a: "Your server works perfectly fine standalone, and every feature stays unlocked. You just won't have access to the Concord Voice Network, your server won't appear in the Public Directory, and you won't have official email support. Community resources on GitHub are always available." },
  { q: 'Do I need Ground Control to self-host?', a: 'No. Network sync and Public Directory listing require an active Ground Control subscription because they use our infrastructure — that is the only part of self-hosting that depends on us.' },
  { q: 'How do I update my server?', a: 'Docker deployments can pull the latest image and restart. Source builds can pull from the repository and rebuild. We publish release notes and migration guides for every version on GitHub.' },
  { q: 'Is Ground Control the same as enterprise support?', a: 'No. Ground Control is for self-hosters who manage their own infrastructure and want a safety net for bugs and questions. If you need SLAs, faster response, dedicated onboarding, or hands-on deployment help, see our Enterprise solutions.' },
  { q: 'Can I run it on a Raspberry Pi?', a: 'Technically yes — the Go backend cross-compiles to ARM. But mediasoup (the voice/video SFU) is CPU-intensive, so voice performance is limited. A Pi 5 with 8 GB RAM can handle a small group; we wouldn\'t recommend more than 10–15 concurrent voice users.' },
  { q: 'Can I run multiple servers on one machine?', a: 'Yes. Each instance needs its own port configuration and database, but nothing prevents multiple deployments on the same hardware. Docker Compose makes this straightforward. Each server that needs Ground Control requires its own subscription.' },
];
---
<Layout
  title="Self-Hosting — Concord Voice"
  description="Self-host Concord Voice on your own hardware — every feature unlocked, free for personal and non-commercial use. Requirements, deploy steps, hosting costs, and licensing."
>
  <Header />

  <main class="mx-auto w-full max-w-6xl px-6 pb-24 pt-10">
    <section class="mkt-hero">
      <p class="eyebrow text-gradient">Self-Hosting</p>
      <h1 class="display mkt-hero__title">Self-Host Concord Voice</h1>
      <p class="mkt-lead">Your hardware. Your rules. <span class="text-gradient">Every feature.</span></p>
      <nav class="anchor-nav">
        {nav.map(([label, href]) => <a href={href} class="pill">{label}</a>)}
      </nav>
    </section>

    <section class="mkt-section">
      <p class="mkt-label eyebrow text-gradient">The Promise</p>
      <div class="mkt-grid mkt-grid--3">
        {promise.map((p) => <div class="pledge reveal"><p class="pledge__t">{p.t}</p><p class="pledge__d">{p.d}</p></div>)}
      </div>
    </section>

    <section class="mkt-section" id="features">
      <p class="mkt-label eyebrow text-gradient">What's Included</p>
      <h2 class="display mkt-section__title">Everything. Out of the box.</h2>
      <div class="mkt-grid">
        <div class="feat reveal"><h3 class="feat__t">Core Platform</h3><ul class="checklist">{core.map((i) => <li>{i}</li>)}</ul></div>
        <div class="feat reveal"><h3 class="feat__t">Every feature unlocked, hardware-limited (you run your own media plane)</h3><ul class="checklist">{mach.map((i) => <li>{i}</li>)}</ul></div>
      </div>
      <p class="mkt-prose" style="margin-top:1.5rem; text-align:center; font-size:.95rem;">
        On our hosted platform, these capabilities are gated behind Mach server subscriptions. On your own hardware, every feature is unlocked —
        we don't believe in charging you to flip a switch on a server you already pay to run.
      </p>
    </section>

    <section class="mkt-section" id="requirements">
      <p class="mkt-label eyebrow text-gradient">What You Need</p>
      <div class="mkt-table-wrap">
        <table class="mkt-table">
          <thead><tr><th>Component</th><th>Minimum</th><th>Recommended</th><th>Notes</th></tr></thead>
          <tbody>{spec.map((r) => <tr><td>{r[0]}</td><td>{r[1]}</td><td>{r[2]}</td><td>{r[3]}</td></tr>)}</tbody>
        </table>
      </div>
    </section>

    <section class="mkt-section" id="deploy">
      <p class="mkt-label eyebrow text-gradient">How to Deploy</p>
      <h2 class="display mkt-section__title">Three paths to a running server</h2>
      <div class="mkt-grid mkt-grid--3">
        {deploy.map((d) => (
          <div class="feat reveal deploy">
            <h3 class="feat__t">{d.name}{d.soon && <span class="soon">Coming soon</span>}</h3>
            <p class="feat__d">{d.desc}</p>
            {d.code.length > 0 && <pre class="code"><code>{d.code.join('\n')}</code></pre>}
            <p class="deploy__note">{d.note}</p>
            <span class="deploy__cta">{d.cta} →</span>
          </div>
        ))}
      </div>
    </section>

    <section class="mkt-section" id="costs">
      <p class="mkt-label eyebrow text-gradient">Hosting Cost Estimates</p>
      <h2 class="display mkt-section__title">What it actually costs to run</h2>
      <p class="mkt-section__sub">Self-hosting is free on the software side. Here's what the hardware typically runs, based on real provider pricing.</p>
      <div class="mkt-table-wrap">
        <table class="mkt-table">
          <thead><tr><th>Community size</th><th>Concurrent</th><th>Server spec</th><th>Est. cost</th><th>Notes</th></tr></thead>
          <tbody>{costs.map((r) => <tr><td>{r[0]}</td><td>{r[1]}</td><td>{r[2]}</td><td class="yes">{r[3]}</td><td>{r[4]}</td></tr>)}</tbody>
        </table>
      </div>
    </section>

    <section class="mkt-section" id="ground-control">
      <p class="mkt-label eyebrow text-gradient">Ground Control</p>
      <h2 class="display mkt-section__title">Network. Support. Connected.</h2>
      <p class="mkt-section__sub">
        Self-hosting is free and every feature is unlocked. But if you want your server connected to the broader
        Concord Voice ecosystem — and official support when you need it — Ground Control is how. Without it,
        self-hosted servers receive no official support.
      </p>
      <div class="mkt-grid mkt-grid--3">
        {gcIncluded.map((g) => <div class="pledge reveal"><p class="pledge__t">{g.t}</p><p class="pledge__d">{g.d}</p></div>)}
      </div>
      <div class="gc-split">
        <div class="feat">
          <h3 class="feat__t">What's not included</h3>
          <ul class="checklist checklist--x">{gcNot.map((i) => <li>{i}</li>)}</ul>
          <p class="feat__d" style="margin-top:.9rem;">Need hands-on support, SLAs, or dedicated onboarding? See our <a href="/enterprise-msp" style="color:var(--color-coral)">Enterprise solutions</a>.</p>
        </div>
        <div class="feat">
          <h3 class="feat__t">Ground Control pricing</h3>
          <div class="mkt-table-wrap" style="margin-top:.4rem;">
            <table class="mkt-table" style="min-width:0;">
              <thead><tr><th>Term</th><th>Total</th><th>Per year</th><th>Savings</th></tr></thead>
              <tbody>{gcPricing.map((r) => <tr><td>{r[0]}</td><td>{r[1]}</td><td>{r[2]}</td><td class="yes">{r[3]}</td></tr>)}</tbody>
            </table>
          </div>
          <p class="feat__d" style="margin-top:.8rem;">Per server. Multi-year discounts apply per subscription.</p>
        </div>
      </div>
    </section>

    <section class="mkt-section" id="licensing">
      <p class="mkt-label eyebrow text-gradient">Licensing</p>
      <h2 class="display mkt-section__title">How the license works</h2>
      <div class="mkt-grid">
        <div class="feat reveal">
          <h3 class="feat__t">Free — personal &amp; non-commercial</h3>
          <ul class="checklist">{licFree.map((i) => <li>{i}</li>)}</ul>
          <p class="feat__d" style="margin-top:.9rem;">If your server exists to connect people and nobody's paying or being charged, you're covered.</p>
        </div>
        <div class="feat reveal">
          <h3 class="feat__t">Commercial license required (CVSL)</h3>
          <ul class="checklist checklist--arrow">{licCommercial.map((i) => <li>{i}</li>)}</ul>
          <p class="feat__d" style="margin-top:.9rem;">Commercial licensing keeps the project funded. The CVSL converts to AGPL-3.0 automatically after 4 years — your investment is permanent.</p>
        </div>
      </div>
    </section>

    <section class="mkt-section" id="faq">
      <p class="mkt-label eyebrow text-gradient">FAQ</p>
      <div class="faq">
        {faq.map((f) => (
          <details class="faq__item">
            <summary class="faq__q">{f.q}</summary>
            <p class="faq__a">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mkt-cta reveal">
      <p class="eyebrow text-gold">Your hardware, your rules</p>
      <h2 class="display mkt-cta__title">Deploy it. Own it. Forever.</h2>
      <a href="https://github.com/Concord-Voice" target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="margin-top:1.5rem;">View on GitHub →</a>
    </section>
  </main>

  <Footer />

  <style>
    .code { margin: 0.9rem 0; padding: 0.9rem 1rem; border-radius: 0.7rem; background: color-mix(in oklab, #000 45%, transparent); border: 1px solid color-mix(in oklab, var(--color-paper) 12%, transparent); overflow-x: auto; }
    .code code { font-family: var(--font-mono); font-size: 0.82rem; color: color-mix(in oklab, var(--color-gold) 80%, var(--color-paper)); white-space: pre; line-height: 1.7; }
    .deploy { display: flex; flex-direction: column; }
    .deploy__note { font-size: 0.82rem; color: var(--color-mist); line-height: 1.5; margin-top: auto; }
    .deploy__cta { margin-top: 0.9rem; font-weight: 700; color: var(--color-coral); font-size: 0.9rem; }
    .soon { margin-left: 0.5rem; font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-gold); border: 1px solid color-mix(in oklab, var(--color-gold) 45%, transparent); border-radius: 9999px; padding: 0.1rem 0.45rem; vertical-align: middle; }
    .gc-split { display: grid; gap: 1rem; margin-top: 1rem; grid-template-columns: 1fr; }
    @media (min-width: 800px) { .gc-split { grid-template-columns: 1fr 1fr; align-items: start; } }
  </style>
</Layout>
