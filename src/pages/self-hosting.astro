---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import '@styles/marketing.css';
---

<Layout
  title="Self-Hosting Early Access | Concord Voice"
  description="The Concord Voice source is public. Supported self-hosted installation and deployment guidance are not publicly released yet."
>
  <Header />

  <main class="mx-auto w-full max-w-6xl px-6 pb-24 pt-10">
    <section class="mkt-hero">
      <p class="eyebrow text-gradient">Self-Hosting</p>
      <h1 class="display mkt-hero__title">Self-hosting early access</h1>
      <p class="mkt-lead">
        Concord Voice source is public; the supported self-hosted installer and deployment guide are not publicly released yet.
        Commercial self-hosting requires a <a href="/commercial-license">Concord Voice commercial license</a>.
      </p>
    </section>

    <section class="mkt-section">
      <p class="mkt-label eyebrow text-gradient">Operator-assisted pilot</p>
      <h2 class="display mkt-section__title">Work directly with the Concord Voice team.</h2>
      <p class="mkt-section__sub">
        Early access is an operator-assisted pilot, not a supported downloadable installer or public self-service deployment.
      </p>
      <div class="mkt-cta-row">
        <a href="mailto:contact-us@concordvoice.com?subject=Self-hosted%20early-access%20pilot" class="btn btn-primary">Interested in a self-hosted early-access pilot? Contact us.</a>
        <a href="/license" class="btn border border-white/20 hover:border-coral">Read the CVSL 1.0 →</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
