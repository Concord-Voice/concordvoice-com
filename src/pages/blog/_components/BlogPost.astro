---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import './blog.css';

interface Heading { depth: number; slug: string; text: string; }
interface Props {
  title: string;
  description?: string;
  category?: string;
  pubDate: string | Date;
  readingTime?: number;
  tags?: string[];
  headings?: Heading[];
  prev?: { slug: string; title: string } | null;
  next?: { slug: string; title: string } | null;
}
const { title, description, category, pubDate, readingTime, headings = [], prev = null, next = null } = Astro.props;

const base = '/blog';
const date = new Date(pubDate);
const dateLabel = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const dateISO = date.toISOString().slice(0, 10);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<Layout title={`${title} | Concord Voice`} description={description}>
  <div class="signal-rail" aria-hidden="true"><span class="signal-rail__fill"></span></div>

  <Header />

  <main class="mx-auto w-full max-w-6xl px-6 pb-24 pt-10">
    <div class="post-grid">
      <header class="post-hero">
        <a href={base} class="post-back eyebrow">← All Posts</a>
        <p class="post-kicker eyebrow">
          {category && <span class="text-gradient">{category}</span>}
          <span class="post-kicker__meta">
            <time datetime={dateISO}>{dateLabel}</time>{readingTime ? ` · ${readingTime} min read` : ''}
          </span>
        </p>
        <h1 class="display post-title">{title}</h1>
        {description && <p class="post-standfirst">{description}</p>}
        <div class="post-rule" aria-hidden="true"></div>
      </header>

      {toc.length > 2 && (
        <aside class="post-toc" aria-label="Table of contents">
          <details class="post-toc__d" open>
            <summary class="eyebrow text-mist">Contents</summary>
            <nav>
              <ol>
                {toc.map((h) => (
                  <li class={`toc-d${h.depth}`}><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>
                ))}
              </ol>
            </nav>
          </details>
        </aside>
      )}

      <article class="legal post-prose">
        <slot />
      </article>

      <nav class="post-pager" aria-label="More posts">
        {prev ? (
          <a class="post-pager__link" href={`${base}/${prev.slug}`}>
            <span class="eyebrow text-mist">← Previous</span>
            <span class="post-pager__t">{prev.title}</span>
          </a>
        ) : <span></span>}
        {next ? (
          <a class="post-pager__link post-pager__link--next" href={`${base}/${next.slug}`}>
            <span class="eyebrow text-mist">Next →</span>
            <span class="post-pager__t">{next.title}</span>
          </a>
        ) : <span></span>}
      </nav>
    </div>
  </main>

  <Footer />

  <script>
    // Reading-progress "signal" rail + active-section TOC highlight.
    const rail = document.querySelector<HTMLElement>('.signal-rail__fill');
    const article = document.querySelector<HTMLElement>('.post-prose');
    if (rail && article) {
      let ticking = false;
      const update = () => {
        ticking = false;
        const vh = window.innerHeight || document.documentElement.clientHeight;
        const start = article.offsetTop;
        const end = start + article.offsetHeight - vh;
        const p = Math.min(1, Math.max(0, (window.scrollY - start) / Math.max(1, end - start)));
        rail.style.transform = `scaleY(${p})`;
      };
      addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      addEventListener('resize', update);
      update();

      const links = Array.from(document.querySelectorAll<HTMLElement>('[data-toc]'));
      const heads = Array.from(document.querySelectorAll<HTMLElement>('.post-prose h2[id], .post-prose h3[id]'));
      if (links.length && heads.length) {
        const map = new Map(links.map((a) => [a.getAttribute('data-toc'), a]));
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                links.forEach((l) => l.classList.remove('is-active'));
                map.get(e.target.id)?.classList.add('is-active');
              }
            }
          },
          { rootMargin: '0px 0px -78% 0px', threshold: 0 },
        );
        heads.forEach((h) => io.observe(h));
      }
    }
  </script>
</Layout>
