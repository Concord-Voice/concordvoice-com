---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import FoundersOffer from '@components/FoundersOffer.astro';
import FoundersPrice from '@components/FoundersPrice.astro';
import { cents, foundersOffer, foundersPrice, foundersTerms, money as centsMoney } from '../lib/founders-pricing';
import '@styles/marketing.css';

// Cloud pricing for COMMUNITIES & TEAMS. Split out of
// the old personal-use page (individual plans are on /pricing, the comparison on /compare).
const money = (n: number) => (n === 0 ? '$0' : `$${n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`);

const serverTiers = [
  { name: 'Groundspeed', monthly: 0, desc: 'For friends, family, clans, guilds, and small communities',
    items: ['Unlimited channels & categories', 'End-to-end encrypted messaging', 'Voice & video channels (standard quality)', 'Screen sharing (up to 1080p · 30fps)', 'Basic server icon & banner', '32MB file upload limit per file', '100 custom emoji (incl. animated)', '10 custom stickers', 'Up to 8 screen shares and 8 cameras live at once per voice channel, counted separately'] },
  { name: 'Mach 1', monthly: 4.99, yearly: 54.89, desc: 'Entry-level server boost for communities that want more',
    items: ['Everything in Groundspeed', 'Animated GIF server banner and icon', 'Up to 510 kbps audio, server-wide*', '1080p/60 video, server-wide*', '256 MB per-file uploads, server-wide', '250 GB server storage (fair-use ceiling)', '250 custom emoji / 75 stickers / 30 soundboards', 'List your server in the Public Directory (optional)', 'Every voice channel lifts to 16 screen shares and 25 cameras at once, server-wide†'] },
  { name: 'Mach 2', monthly: 14.99, yearly: 164.89, featured: true, desc: 'For active communities that want a step up in quality',
    items: ['Everything in Mach 1', 'Custom invite links', '1440p/60 video, server-wide*', '512 MB per-file uploads, server-wide', '1 TB server storage', '350 custom emoji / 100 stickers / 40 soundboards', 'Server tag', 'Priority support'] },
  { name: 'Mach 3', monthly: 34.99, yearly: 384.89, desc: 'Maximum quality for large, media-rich communities',
    items: ['Everything in Mach 2', '4K/60 video, server-wide*', '1 GB per-file uploads, server-wide', '2.5 TB server storage', '500 custom emoji / 150 stickers / 55 soundboards'] },
];
// Pending group-plan catalog; prices are previews, not purchase offers.
const squadron = [
  { name: 'Squadron-4', members: 4, slots: 1, monthly: 42.99, yearly: 472.89 },
  { name: 'Squadron-8', members: 8, slots: 1, monthly: 72.99, yearly: 802.89, featured: true },
  { name: 'Squadron-12', members: 12, slots: 1, monthly: 104.99, yearly: 1154.89 },
];
const afterburner = [
  { tier: 'Mach 2', n: 2, per: 8.03, pool: 16.05 }, { tier: 'Mach 2', n: 3, per: 5.45, pool: 16.36 },
  { tier: 'Mach 3', n: 5, per: 7.52, pool: 37.58 }, { tier: 'Mach 3', n: 7, per: 5.46, pool: 38.20 },
];
---
<Layout
  title="Groups & Communities | Concord Voice"
  description="Pricing for a private community home: hosted servers, group plans, and upgrades that lift the experience for everyone in your crew."
>
  <Header />

  <main class="mx-auto w-full max-w-7xl px-6 pb-24 pt-10">
    <section class="mkt-hero">
      <p class="eyebrow text-gold">Groups &amp; Communities</p>
      <h1 class="display mkt-hero__title">For the people who make your place feel like home</h1>
      <p class="mkt-lead">
        Run a community, guild, or team with a space that belongs to all of you. Every hosted server starts free; premium plans lift the experience for everyone in it.
        <span class="teams-personal-link">Looking for individual plans? <a href="/pricing">See Personal Use →</a></span>
      </p>
    </section>

    <section class="mkt-section"><p class="mkt-label eyebrow text-gold">Choose What You Are Lifting Up</p><h2 class="display mkt-section__title">A shared place works better when the upgrade helps everyone.</h2><p class="mkt-section__sub">Start a community free, then choose the support that matches how your people gather: improve one server, carry premium with a crew, or split the cost together. The price follows the benefit, not the other way around.</p></section>

    <FoundersOffer />

    <section class="mkt-section" id="servers">
      <p class="mkt-label eyebrow text-gold">Hosted Server Pricing</p>
      <h2 class="display mkt-section__title">Boost the whole server</h2>
      <p class="plan-status">Mach subscriptions are coming later · Groundspeed stays free</p>
      <p class="mkt-section__sub">
        Servers come in two flavors, hosted by us, or run by you. Either way, the basics are always free; a Mach
        boost lifts quality and unlocks extras for <em>every</em> member, not just the person who pays. Audio quality is the
        channel admin-set standard (server-gated, uplifting all members including free); video quality is the better of your
        personal cap or the server floor.
      </p>
      <div class="bill-wrap">
        <div class="bill-toggle" role="group" aria-label="Billing period">
          <button type="button" class="bill-toggle__btn is-active" data-bill="monthly" aria-pressed="true">Monthly</button>
          <button type="button" class="bill-toggle__btn" data-bill="yearly" aria-pressed="false">Yearly <span class="bill-toggle__tag">Billed yearly</span></button>
        </div>
      </div>
      <div class="mkt-grid">
        {serverTiers.map((t) => (
          <div class:list={['tier', 'reveal', t.featured && 'tier--featured']}>
            <p class="tier__name eyebrow text-gold">{t.name}</p>
            <FoundersPrice monthly={t.monthly} yearly={t.yearly} pending={t.monthly > 0} />
            <p class="tier__desc">{t.desc}</p>
            <ul class="checklist">{t.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
      <p class="fineprint">
        Extra-server options are planned for a later release.
        Need something bigger? Reach out at <a href="mailto:contact-us@concordvoice.com">contact-us@concordvoice.com</a>. &nbsp;<br />
        * Requires devices and networks that support the necessary encoding and bitrates; otherwise expect
        degraded quality. &nbsp;<br />
        † Screen-share and camera limits are separate, not a shared pool. Concurrency is the same across the Mach
        ladder: Mach 1, 2, and 3 all unlock 16 screen shares and 25 cameras per channel, for every member. Server
        plans activate in a later release; until then every channel uses the free caps (8 screen shares and 8 cameras).
      </p>
    </section>

    <!-- ===== Squadron (group plan) ===== -->
    <section class="mkt-section" id="squadron">
      <p class="mkt-label eyebrow text-gold">Squadron</p>
      <h2 class="display mkt-section__title">One subscription for your whole crew</h2>
      <p class="plan-status">Coming later · not available to purchase</p>
      <p class="mkt-section__sub">
        Mach boosts your server; Squadron boosts your <em>people</em>. One bill, one Captain, every member gets
        Supersonic that travels with them to every server, boosted or not. The Captain picks the Mach tier (Mach 2 default)
        for the included boost. Extra-server options are planned for a later release.
      </p>
      <div class="bill-wrap bill-wrap--inline">
        <div class="bill-toggle" role="group" aria-label="Billing period">
          <button type="button" class="bill-toggle__btn is-active" data-bill="monthly" aria-pressed="true">Monthly</button>
          <button type="button" class="bill-toggle__btn" data-bill="yearly" aria-pressed="false">Yearly <span class="bill-toggle__tag">Billed yearly</span></button>
        </div>
      </div>
      <div class="mkt-grid mkt-grid--3">
        {squadron.map((s) => (
          <div class:list={['tier', 'reveal', s.featured && 'tier--featured']}>
            <p class="tier__name eyebrow text-gold">{s.name}</p>
            <FoundersPrice monthly={s.monthly} yearly={s.yearly} pending members={s.members} /><div class="mach-card-picker" data-mach-picker><p class="fineprint" style="margin:0 0 .55rem">Included Mach boost</p><div class="bill-toggle" role="group" aria-label="Choose Mach tier"><button type="button" class="bill-toggle__btn" data-mach-option data-monthly="-10" data-yearly="-110">Mach 1</button><button type="button" class="bill-toggle__btn is-active" data-mach-option data-monthly="0" data-yearly="0" aria-pressed="true">Mach 2</button><button type="button" class="bill-toggle__btn" data-mach-option data-monthly="20" data-yearly="220">Mach 3</button></div></div>
            <p class="tier__desc">Up to {s.members} members · 1 Mach boost (Captain picks Mach 1, Mach 2, or Mach 3)</p>
            <ul class="checklist">
              <li>Supersonic for up to {s.members} members, portable across DMs &amp; every server</li>
              <li>1 Mach boost, Captain picks Mach 1, Mach 2 (default), or Mach 3</li>
              <li>The Captain manages the roster and one bill</li>
              <li>Extra-server options planned for a later release</li>
            </ul>
          </div>
        ))}
      </div>
      <p class="fineprint">Built on “trust by design”, no IP tracking, no household checks, no nag banners. Members' premium is theirs; the Captain holds the bill.</p>
    </section>

    <!-- ===== Afterburner (crowd-funded boost) ===== -->
    <section class="mkt-section" id="afterburner">
      <p class="mkt-label eyebrow text-gold">Afterburner</p>
      <h2 class="display mkt-section__title">Crowd-fund a server boost</h2>
      <p class="plan-status">Coming later · non-final estimates</p>
      <p class="mkt-section__sub">
        A fair pledge-to-unlock pool, nobody is charged until pledges reach the Mach tier price. Pick Mach 2 or Mach 3;
        contributors share the cost. This feature is not available yet.
        The examples below show the existing estimated pool totals with a 50% founders reduction. Final split-billing prices and fees are pending.
      </p>
      <div class="mkt-grid">
        {afterburner.map((a) => (
          <div class:list={['tier', 'ab-card', 'reveal', (a.tier === 'Mach 2' && a.n === 3) && 'tier--featured']}>
            <p class="tier__name eyebrow text-gold">{a.tier} · {a.n} contributors</p>
            <p class="ab-price"><span class="founders-price__regular">Regular <s>{money(a.per)}/month each</s></span><span class="founders-price__label">Founders · 50% off estimate</span><span class="ab-amt display">~{centsMoney(Math.round(foundersPrice(cents(a.pool)) / a.n))}</span><small>/month each</small></p>
            <p class="tier__desc">Estimated pool: <s>{money(a.pool)}</s> {centsMoney(foundersPrice(cents(a.pool)))}/month</p>
          </div>
        ))}
      </div>
      <details class="faq__item ab-detail">
        <summary class="faq__q">How is Afterburner priced?</summary>
        <p class="faq__a">Afterburner is a planned pledge-to-unlock pool for a Mach 2 or Mach 3 boost. It is not available yet. The pool and per-contributor amounts above are illustrative estimates showing a 50% founders reduction; final fees and billing details are pending. Per-contributor estimates are rounded and may not add up exactly to the displayed pool total.</p>
      </details>
    </section>

    <section class="mkt-section">
      <p class="mkt-label eyebrow text-gold">Just You?</p>
      <h2 class="display mkt-section__title">Looking for personal pricing?</h2>
      <p class="mkt-section__sub">Sonic (free), Supersonic, and the all-in-one Hypersonic and Wing plans live on the personal pricing page.</p>
      <div class="mkt-cta-row">
        <a href="/pricing" class="btn border border-white/20 hover:border-coral">Personal Use →</a>
        <a href="/compare" class="btn border border-white/20 hover:border-coral">Compare every plan →</a>
      </div>
    </section>

    <section class="mkt-section" id="pricing-faq">
      <p class="mkt-label eyebrow text-gold">Pricing FAQ</p>
      <div class="faq">
        <details class="faq__item"><summary class="faq__q">Which paid plans are available?</summary><p class="faq__a">Supersonic and Wing are available now. Hypersonic, Mach subscriptions and Wing Mach add-ons, Squadron, and Afterburner are coming later. Prices for pending plans are non-final preview estimates and may change before launch. They are not an offer to subscribe today or a reservation of founders pricing.</p></details>
        <details class="faq__item"><summary class="faq__q">How long does my founders price stay locked?</summary><p class="faq__a">Founders signup is open until {foundersOffer.signupDeadline}. {foundersTerms.priceLock} {foundersTerms.grace} {foundersTerms.ends}</p></details>
        <details class="faq__item"><summary class="faq__q">What stays free?</summary><p class="faq__a">Groundspeed hosted servers and the core community experience stay free. Paid plans add optional upgrades.</p></details>
      </div>
    </section>

    <section class="mkt-cta reveal">
      <p class="eyebrow text-gold">One bill. Everyone covered.</p>
      <h2 class="display mkt-cta__title">Bring your community along.</h2>
      <a href="/download" class="btn btn-primary" style="margin-top:1.5rem;">Download the Beta</a>
    </section>
  </main>

  <Footer />

  <style>
    .teams-personal-link { display: block; margin-top: .8rem; }
    .teams-personal-link a { color: var(--color-coral); }
    .fineprint { max-width: 46rem; margin: 1.6rem auto 0; font-size: 0.78rem; line-height: 1.6; color: var(--color-mist); text-align: center; }
    .fineprint a { color: var(--color-coral); }

    /* Afterburner */
    .ab-card { text-align: center; }
    .ab-price { margin: .35rem 0 .5rem; }
    .ab-amt { font-size: clamp(1.8rem, 5vw, 2.4rem); line-height: 1; }
    .ab-price small { color: var(--color-mist); font-size: .85rem; }
    .ab-detail { max-width: 46rem; margin: 1.4rem auto 0; } .plan-config { display:grid; justify-items:center; gap:.9rem; } .mach-card-picker { text-align:center; } .mach-card-picker .bill-toggle { flex-wrap:wrap; justify-content:center; } @media (min-width:720px) { .plan-config { grid-template-columns:auto auto; align-items:center; justify-content:center; } .mach-card-picker { text-align:left; } }
  </style>
</Layout>
