---
import Layout from '../layouts/Layout.astro';

// Unlisted. Reached only by decoding the stamp in the blog footer (Vigenere,
// key HOURS). Deliberately not linked from anywhere, not in any nav, and the
// site ships no sitemap or robots.txt, so nothing advertises this path.
// noindex is belt-and-braces against a crawler that finds it by other means.
const CODE = 'CV-SWCXK-0ZFWS-AEN2W-RF559-BEVYB-SF';
---

<Layout
  title="Concord Voice"
  description="Nothing here."
  noindex
>
  <main class="mx-auto flex min-h-screen max-w-2xl flex-col justify-center px-6 py-24">
    <p class="eyebrow text-mist">SETEC ASTRONOMY</p>

    <h1 class="display mt-4 text-3xl sm:text-4xl">You read the board.</h1>

    <p class="mt-6 text-mist">
      Most people watched a video about encryption. You mirrored the footage,
      found a key on a mislabeled axis, and then went looking for what the key
      was actually for.
    </p>

    <p class="mt-4 text-mist">Take this to Settings, then Subscriptions, then Redeem a Code.</p>

    <p class="mt-8 select-all font-mono text-lg tracking-wide">{CODE}</p>

    <p class="mt-10 text-sm text-mist">
      Eleven more. The graph told you how many.
    </p>
  </main>
</Layout>
