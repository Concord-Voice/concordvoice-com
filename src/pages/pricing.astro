---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import '@styles/marketing.css';

// Cloud pricing for INDIVIDUALS. Renamed from the old
// personal-use page; team/community plans now live on /teams, the comparison on /compare.
// Prices toggle monthly/yearly (yearly = 11× monthly, one month free → computed in Layout JS).
const money = (n: number) => (n === 0 ? '$0' : `$${n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`);
const savePct = (m: number, y: number) => (m > 0 && y > 0 ? Math.round((1 - y / (m * 12)) * 100) : 0);

const userTiers = [
  { name: 'Sonic', monthly: 0, desc: 'For individuals and communities getting started',
    items: ['Voice & video calls', 'End-to-end encrypted messaging', 'Up to five servers with unlimited channels', 'Standard audio (up to 96 kbps)', 'Screen sharing (up to 1080p · 30fps)', 'An assortment of themes & profile customization', 'Direct messages'] },
  { name: 'Supersonic', monthly: 8.99, yearly: 98.89, featured: true, desc: 'For users who want the whole experience',
    items: ['Priority support', 'Optional opt-in to early access', 'Everything in the Free tier', 'Full customization of theme colors', 'GIFs in your profile photos and banners', 'Profile card & page customization', 'Acoustically transparent 48kHz/16-bit audio (up to 510 kbps)*', 'Native resolution / frame-rate stream support*', 'In group DMs, up to 16 screen shares and 25 cameras at once†', '256 MB file uploads in any chat or DM', 'No cap on server creation', '180-day message-history search depth**'] },
];
const hyper = { monthly: 21.99, yearly: 241.89 };
const hyperYou = ['Priority support', 'Optional opt-in to early access', 'Full theme-color customization', 'GIFs in profile photos and banners', 'Profile card & page customization', 'Acoustically transparent 48kHz/16-bit audio (up to 510 kbps)*', 'Native resolution / frame-rate stream support*', '256 MB file uploads anywhere', 'No cap on server creation', '180-day message-history search depth**'];
const hyperServer = ['Priority support', 'Animated GIF server banner', 'Custom invite links', '350 custom emoji (incl. animated)', '100 custom stickers', '256 MB per-file uploads, server-wide', '1 TB server storage', 'Server tag', 'Up to 510 kbps audio, server-wide*', '1440p/60 video, server-wide*', 'List your server in the Public Directory (optional)'];
const wing = { monthly: 14.99, yearly: 164.89 };

---
<Layout
  title="Personal Use | Concord Voice"
  description="Honest personal pricing for Concord Voice: private voice, video, and chat for the places you share with your people, with no dark patterns."
>
  <Header />

  <main class="mx-auto w-full max-w-7xl px-6 pb-24 pt-10">
    <section class="mkt-hero">
      <p class="eyebrow text-gradient">Personal Use</p>
      <h1 class="display mkt-hero__title">A private place, priced honestly</h1>
      <p class="mkt-lead">
        We believe in a free and open platform, so personal use of Concord Voice is free, always and forever.
        Whether you use a server on the Concord Voice Network or host it yourself, we'll never charge you for
        privacy or messaging, or limit your communications. Community over profit.
      </p>
    </section>

    <section class="mkt-section"><p class="mkt-label eyebrow text-gradient">Choose the shape of your support</p><h2 class="display mkt-section__title">Start with your people, not a price card.</h2><p class="mkt-section__sub">Everyone gets a private place to talk for free. Personal Use is for higher fidelity, more expression, or helping a small circle. If you are improving a shared home for everyone inside it, Groups &amp; Communities is the better fit.</p></section>

    <!-- ===== Hosted service + self-hosting early access ===== -->
    <section class="mkt-section">
      <p class="mkt-label eyebrow text-gradient">Hosted service and early access</p>
      <h2 class="display mkt-section__title">Start on the Concord Voice Network.</h2>
      <p class="mkt-section__sub">
        The hosted service is available today. Self-hosting early access is operator-assisted, not a supported
        downloadable installer.
      </p>
      <div class="mkt-grid fork">
        <div class="fork-card reveal">
          <p class="fork-card__k eyebrow text-gradient">Cloud · we host it</p>
          <h3 class="fork-card__t">Hosted by us</h3>
          <p class="fork-card__d">
            Sign up and start talking. We run the infrastructure, updates, and uptime. Free to use, with optional
            premium plans for higher fidelity and extras. <strong>You are here.</strong>
          </p>
          <a href="#plans" class="btn border border-white/20 hover:border-coral">See cloud plans ↓</a>
        </div>
        <div class="fork-card reveal">
          <p class="fork-card__k eyebrow text-gradient">Self-hosting · early access</p>
          <h3 class="fork-card__t">Operator-assisted pilot</h3>
          <p class="fork-card__d">
            Concord Voice source is public; the supported self-hosted installer and deployment guide are not
            publicly released yet. Commercial self-hosting requires a <a href="/commercial-license">Concord Voice commercial license</a>.
          </p>
          <a href="mailto:contact-us@concordvoice.com?subject=Self-hosted%20early-access%20pilot" class="btn border border-white/20 hover:border-coral">Interested in a self-hosted early-access pilot? Contact us.</a>
        </div>
      </div>
    </section>

    <section class="mkt-section" id="plans">
      <p class="mkt-label eyebrow text-gradient">Cloud Plans</p>
      <h2 class="display mkt-section__title">Honest. No Dark Patterns. No Shareholders.</h2>
      <p class="mkt-section__sub">
        Privacy isn't a premium feature. It's the baseline. Every account gets end-to-end encryption, voice and
        video, and full messaging. Premium plans simply unlock higher fidelity and advanced capabilities.
      </p>
      <div class="bill-wrap">
        <div class="bill-toggle" role="group" aria-label="Billing period">
          <button type="button" class="bill-toggle__btn is-active" data-bill="monthly" aria-pressed="true">Monthly</button>
          <button type="button" class="bill-toggle__btn" data-bill="yearly" aria-pressed="false">Yearly <span class="bill-toggle__tag">1 mo free</span></button>
        </div>
      </div>
      <div class="mkt-grid">
        {userTiers.map((t) => (
          <div class:list={['tier', 'reveal', t.featured && 'tier--featured']}>
            <p class="tier__name eyebrow text-gradient">{t.name}</p>
            <p class="tier__price" data-m={money(t.monthly)} data-y={t.yearly ? money(t.yearly) : ''} data-save={t.yearly ? savePct(t.monthly, t.yearly) : 0} data-per={t.monthly > 0 ? '/month' : ''}>
              <span class="tier__amt">{money(t.monthly)}</span><small class="tier__per">{t.monthly > 0 ? '/month' : ''}</small>
              <span class="tier__save" hidden> · save {t.yearly ? savePct(t.monthly, t.yearly) : 0}%</span>
            </p>
            <p class="tier__desc">{t.desc}</p>
            <ul class="checklist">{t.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
      <p class="fineprint">
        * Requires your device and network to support the necessary encoding and bitrates; otherwise expect
        degraded quality. &nbsp; ** Searchable only while the messages still exist, per your retention policy. &nbsp;<br />
        † Group-DM screen-share and camera limits are separate, not a shared pool: 8 of each by default, raised to
        16 screen shares and 25 cameras when anyone in the call is on Supersonic or higher. Per-channel concurrency
        inside a server follows that server's plan, not your personal one. Applies once personal plans are on sale.
      </p>
    </section>

    <section class="mkt-section" id="hypersonic">
      <p class="mkt-label eyebrow text-gradient">Hypersonic</p>
      <h2 class="display mkt-section__title">Everything, in one plan</h2>
      <p class="mkt-section__sub">
        The complete experience: a Supersonic account <em>and</em> a bundled Mach 2 server boost (1440p/60 video, up to 510 kbps audio, server-wide), at a
        better price than buying them separately. One account, one bill, everything on.
      </p>
      <div class="bill-wrap bill-wrap--inline">
        <div class="bill-toggle" role="group" aria-label="Billing period">
          <button type="button" class="bill-toggle__btn is-active" data-bill="monthly" aria-pressed="true">Monthly</button>
          <button type="button" class="bill-toggle__btn" data-bill="yearly" aria-pressed="false">Yearly <span class="bill-toggle__tag">1 mo free</span></button>
        </div>
      </div>
      <div class="hyper-band reveal">
        <div class="hyper-band__head"><div class="plan-config">
          <p class="hyper-price__big display tier__price" data-m={money(hyper.monthly)} data-y={money(hyper.yearly)} data-save={savePct(hyper.monthly, hyper.yearly)} data-per="/month">
            <span class="tier__amt">{money(hyper.monthly)}</span><small class="tier__per">/month</small>
            <span class="tier__save" hidden> · save {savePct(hyper.monthly, hyper.yearly)}%</span>
          </p><div class="mach-card-picker" data-mach-picker><p class="fineprint" style="margin:0 0 .55rem">Included Mach boost</p><div class="bill-toggle" role="group" aria-label="Choose Mach tier"><button type="button" class="bill-toggle__btn" data-mach-option data-monthly="-10" data-yearly="-110">Mach 1</button><button type="button" class="bill-toggle__btn is-active" data-mach-option data-monthly="0" data-yearly="0" aria-pressed="true">Mach 2</button><button type="button" class="bill-toggle__btn" data-mach-option data-monthly="20" data-yearly="220">Mach 3</button></div></div>
        </div>
        </div>
        <div class="hyper-band__lists">
          <div>
            <p class="hyper-list__t eyebrow text-gradient">You: free tier, plus</p>
            <ul class="checklist">{hyperYou.map((i) => <li>{i}</li>)}</ul>
          </div>
          <div>
            <p class="hyper-list__t eyebrow text-gradient">Your server: free tier, plus</p>
            <ul class="checklist">{hyperServer.map((i) => <li>{i}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== Wing (2-user), PROPOSED pricing ===== -->
    <section class="mkt-section" id="wing">
      <p class="mkt-label eyebrow text-gradient">Wing</p>
      <h2 class="display mkt-section__title">Bring your favorite person along</h2>
      <p class="mkt-section__sub">
        A two-person plan: <strong data-wing-summary-plan>Supersonic for you</strong> and <strong>Supersonic for your +1</strong>. Two
        portable premium seats. Your personal uplift travels with you to every server, boosted or not.
      </p>
      <div class="bill-wrap bill-wrap--inline">
        <div class="bill-toggle" role="group" aria-label="Billing period">
          <button type="button" class="bill-toggle__btn is-active" data-bill="monthly" aria-pressed="true">Monthly</button>
          <button type="button" class="bill-toggle__btn" data-bill="yearly" aria-pressed="false">Yearly <span class="bill-toggle__tag">1 mo free</span></button>
        </div>
      </div>
      <div class="wing-band reveal"><div class="plan-config">
        <p class="hyper-price__big display tier__price" data-m={money(wing.monthly)} data-y={money(wing.yearly)} data-save={savePct(wing.monthly, wing.yearly)} data-per="/month">
          <span class="tier__amt">{money(wing.monthly)}</span><small class="tier__per">/month</small>
          <span class="tier__save" hidden> · save {savePct(wing.monthly, wing.yearly)}%</span>
        </p><div class="mach-card-picker" data-mach-picker><p class="fineprint" style="margin:0 0 .55rem">Shared server boost</p><div class="bill-toggle" role="group" aria-label="Choose Wing server boost"><button type="button" class="bill-toggle__btn is-active" data-mach-option data-monthly="0" data-yearly="0" aria-pressed="true">No boost</button><button type="button" class="bill-toggle__btn" data-mach-option data-monthly="4.99" data-yearly="54.89">Mach 1</button><button type="button" class="bill-toggle__btn" data-mach-option data-monthly="14.99" data-yearly="164.89">Mach 2</button><button type="button" class="bill-toggle__btn" data-mach-option data-monthly="34.99" data-yearly="384.89">Mach 3</button></div></div></div>
        <div class="wing-seats">
          <div><p class="hyper-list__t eyebrow text-gradient">You</p><p class="wing-seat__d">Full <strong data-wing-primary-plan>Supersonic</strong>: portable premium across every server and DM<span data-wing-boost-copy></span>.</p></div>
          <div><p class="hyper-list__t eyebrow text-gradient">Your +1</p><p class="wing-seat__d">Full <strong>Supersonic</strong>: portable premium across every server and DM.</p></div>
        </div>
      </div>
    </section>

    <!-- ===== Pointer to teams + compare ===== -->
    <section class="mkt-section">
      <p class="mkt-label eyebrow text-gradient">Bigger groups?</p>
      <h2 class="display mkt-section__title">Running a community or team?</h2>
      <p class="mkt-section__sub">
        Hosted servers (Groundspeed &amp; Mach), the Squadron group plan, and crowd-funded Afterburner boosts have
        their own page.
      </p>
      <div class="mkt-cta-row">
        <a href="/teams" class="btn border border-white/20 hover:border-coral">Groups &amp; Communities →</a>
        <a href="/compare" class="btn border border-white/20 hover:border-coral">Compare every plan →</a>
      </div>
    </section>

    <section class="mkt-section" id="pricing-faq">
      <p class="mkt-label eyebrow text-gradient">Pricing FAQ</p>
      <div class="faq">
        <details class="faq__item"><summary class="faq__q">So, why offer subscriptions?</summary><div class="faq__a mkt-prose"><p>We want subscriptions to fund a few things without ever limiting the platform for everyone else:</p><ul class="checklist" style="margin:1rem 0 1.2rem;"><li>An enhanced experience for those who want it, without gating the general platform for non-subscribers. <em>(Marketing calls it "maximizing value," or something like that.)</em></li><li>The infrastructure to grow and scale as our user base does. More servers for all you beautiful people, and the talented humans to keep it running. <em>(Ever tried to run Kubernetes? It's a special kind of pain.)</em></li><li>Ongoing development: new features, security improvements, and testing. <em>(The cost of compliance alone is miserable. Who likes lawyers anyway?)</em></li></ul><p>Want to know where your money would go? Read the <a href="/about-us">About</a> page to meet the people behind the app.</p></div></details>
        <details class="faq__item"><summary class="faq__q">When do paid subscriptions start?</summary><p class="faq__a">Paid upgrades are planned for v1.0 General Availability. They are not active during Beta.</p></details>
        <details class="faq__item"><summary class="faq__q">Can paid prices change?</summary><p class="faq__a">Yes. The paid prices shown are planned values and may change before General Availability.</p></details>
        <details class="faq__item"><summary class="faq__q">What stays free?</summary><p class="faq__a">Sonic accounts and personal-use basics stay free. Paid plans add optional upgraded features.</p></details>
      </div>
    </section>

    <section class="mkt-cta reveal">
      <p class="eyebrow text-gold">No credit card. No data sold.</p>
      <h2 class="display mkt-cta__title">Start free. Upgrade only if you want to.</h2>
      <a href="/download" class="btn btn-primary" style="margin-top:1.5rem;">Download the Beta</a>
    </section>
  </main>

  <Footer />

  <style>
    .fineprint { max-width: 46rem; margin: 1.6rem auto 0; font-size: 0.78rem; line-height: 1.6; color: var(--color-mist); text-align: center; }
    .fineprint a { color: var(--color-coral); }

    /* Hosted service + self-hosting early access */
    .fork-card { text-align: left; padding: 1.8rem; border: 1px solid color-mix(in oklab, var(--color-paper) 12%, transparent); border-radius: 1.2rem; background: color-mix(in oklab, var(--color-paper) 4%, transparent); display: flex; flex-direction: column; }
    .fork-card__t { font-size: 1.4rem; margin: 0.3rem 0 0.6rem; }
    .fork-card__d { color: var(--color-mist); line-height: 1.6; flex: 1; margin-bottom: 1.2rem; }
    .fork-card .btn { align-self: flex-start; }

    .hyper-band { max-width: 60rem; margin: 0 auto; padding: 2rem; border: 1px solid color-mix(in oklab, var(--color-coral) 45%, transparent); border-radius: 1.4rem; background: linear-gradient(160deg, color-mix(in oklab, var(--color-gold) 7%, transparent), color-mix(in oklab, var(--color-coral) 11%, transparent)); box-shadow: 0 30px 70px -42px var(--color-coral); }
    .hyper-band__head { text-align: center; margin-bottom: 1.8rem; }
    .hyper-price__big { font-size: clamp(2.6rem, 8vw, 4rem); line-height: 1; }
    .hyper-price__big small { font-family: var(--font-body); font-weight: 600; font-size: 1rem; color: var(--color-mist); }
    .hyper-band__lists { display: grid; gap: 1.6rem; grid-template-columns: 1fr; }
    @media (min-width: 720px) { .hyper-band__lists { grid-template-columns: 1fr 1fr; } }
    .hyper-list__t { margin-bottom: 0.75rem; } .plan-config { display:grid; justify-items:center; gap:.9rem; } .mach-card-picker { text-align:center; } .mach-card-picker .bill-toggle { flex-wrap:wrap; justify-content:center; } @media (min-width:720px) { .plan-config { grid-template-columns:auto auto; align-items:center; justify-content:center; } .mach-card-picker { text-align:left; } }

    /* Wing */
    .wing-band { max-width: 48rem; margin: 0 auto; padding: 2rem; text-align: center; border: 1px solid color-mix(in oklab, var(--color-coral) 40%, transparent); border-radius: 1.4rem; background: linear-gradient(160deg, color-mix(in oklab, var(--color-gold) 6%, transparent), color-mix(in oklab, var(--color-coral) 10%, transparent)); }
    .wing-seats { display: grid; gap: 1.2rem; grid-template-columns: 1fr; margin-top: 1.6rem; text-align: left; }
    @media (min-width: 640px) { .wing-seats { grid-template-columns: 1fr 1fr; } }
    .wing-seat__d { color: var(--color-mist); line-height: 1.55; font-size: .92rem; margin-top: .3rem; }
  </style>
  <script>
    import { machPrices, wingPlanCopy } from '../lib/pricing-interactions';

    const formatMachMoney = (value: number) => '$' + value.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    document.querySelectorAll<HTMLElement>('[data-mach-picker]').forEach((picker) => {
      const scope = picker.closest<HTMLElement>('.tier, .hyper-band, .wing-band');
      if (!scope) return;

      const prices = scope.querySelectorAll<HTMLElement>('.tier__price');
      prices.forEach((price) => {
        price.dataset.baseM ??= price.dataset.m;
        price.dataset.baseY ??= price.dataset.y;
      });

      picker.querySelectorAll<HTMLButtonElement>('[data-mach-option]').forEach((button) => button.addEventListener('click', () => {
        picker.querySelectorAll<HTMLButtonElement>('[data-mach-option]').forEach((option) => {
          const active = option === button;
          option.classList.toggle('is-active', active);
          option.setAttribute('aria-pressed', active ? 'true' : 'false');
        });

        prices.forEach((price) => {
          const prices = machPrices(
            Number(price.dataset.baseM?.replace(/[^0-9.]/g, '')),
            Number(price.dataset.baseY?.replace(/[^0-9.]/g, '')),
            Number(button.dataset.monthly),
            Number(button.dataset.yearly),
          );
          price.dataset.m = formatMachMoney(prices.monthly);
          price.dataset.y = formatMachMoney(prices.yearly);
          const annual = document.querySelector<HTMLElement>('[data-bill].is-active')?.dataset.bill === 'yearly';
          const amount = price.querySelector<HTMLElement>('.tier__amt');
          if (amount) amount.textContent = annual ? price.dataset.y : price.dataset.m;
        });

        if (!picker.closest('#wing')) return;
        const copy = wingPlanCopy(Number(button.dataset.monthly));
        const plan = document.querySelector<HTMLElement>('[data-wing-primary-plan]');
        const summaryPlan = document.querySelector<HTMLElement>('[data-wing-summary-plan]');
        const boostCopy = document.querySelector<HTMLElement>('[data-wing-boost-copy]');
        if (plan) plan.textContent = copy.primaryPlan;
        if (summaryPlan) summaryPlan.textContent = copy.summaryPlan;
        if (boostCopy) boostCopy.textContent = copy.boostCopy;
      }));
    });
  </script>
  <script>
    import { shouldAnimateStarfield, starfieldState } from '../lib/pricing-interactions';

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const hypersonic = document.querySelector('#hypersonic');
      const wing = document.querySelector('#wing');
      const starfield = document.querySelector('.starfield');
    if (hypersonic && wing && starfield) {
      const seedStars = Array.from(starfield.querySelectorAll<HTMLElement>('.star'));
      const download = document.querySelector('.mkt-cta .btn');
      const wingHeading = wing.querySelector('h2');
        const stars = Array.from({ length: 42 }, (_, index) => {
          const star = seedStars[index] ?? document.createElement('span');
          star.className = 'star';
          star.style.left = '0px';
          star.style.top = `${Math.random() * 100}%`;
          star.style.height = '1px';
          star.style.borderRadius = '0';
          star.style.background = 'linear-gradient(to right, var(--color-paper) 0 2px, color-mix(in srgb, var(--color-paper) 62%, transparent) 14%, transparent)';
          star.style.boxShadow = 'none';
          star.style.animation = 'none';
          star.style.transformOrigin = 'left center';
          if (!star.isConnected) starfield.append(star);
          return {
            star,
            distance: Math.random() * (window.innerWidth + 120),
            speed: 0.93 + Math.random() * 0.14,
            brightness: 0.5 + Math.random() * 0.5,
            tail: 10 + Math.random() * 12,
            tailLength: 0,
          };
        });
        let targetIntensity = 0.12;
        let intensity = targetIntensity;
        let previous = performance.now();
        let frame = 0;
        let last = previous;
        let atmosphere = false;
        const frameInterval = 1000 / 45;

        const updateIntensity = () => {
          const viewport = window.innerHeight;
          const hypersonicAt = Math.max(1, hypersonic.getBoundingClientRect().bottom + window.scrollY - viewport);
          const wingHeaderAt = Math.max(hypersonicAt, wingHeading ? wingHeading.getBoundingClientRect().bottom + window.scrollY : hypersonicAt);
          const downloadTop = download ? download.getBoundingClientRect().top + window.scrollY : document.documentElement.scrollHeight;
          const downloadAt = Math.max(wingHeaderAt + 1, downloadTop - viewport);
          const stopAt = downloadAt + 500;
          const state = starfieldState(window.scrollY, { hypersonicAt, wingHeaderAt, stopAt });
          atmosphere = state.atmosphere;
          targetIntensity = state.targetIntensity;
          if (atmosphere) {
            intensity = 0;
            paintStars(performance.now(), 0);
            stop();
          } else start();
        };

        const paintStars = (now, elapsed) => {
          const width = window.innerWidth + 120;
          const peakSpeed = width / 1.65;
          const visibleStars = 9 + intensity * 33;
          stars.forEach((flight, index) => {
            const velocity = 60 + intensity * (peakSpeed - 60) * flight.speed;
            const travel = (flight.distance + elapsed * velocity) % (width + 80);
            const tailLength = Math.round(3 + (velocity / peakSpeed) * flight.tail);
            const visibility = Math.max(0, Math.min(1, visibleStars - index));
            if (tailLength !== flight.tailLength) flight.star.style.width = `${tailLength}px`;
            flight.tailLength = tailLength;
            flight.star.style.transform = `translate3d(${width - travel}px, ${Math.sin(now / 600 + index) * intensity * 8}px, 0)`;
            flight.star.style.opacity = String(visibility * Math.min(.88, .22 + intensity * .68 * flight.brightness));
            flight.star.style.willChange = 'transform, opacity';
            flight.distance = travel;
          });
        };

        const animateStarfield = (now) => {
          frame = requestAnimationFrame(animateStarfield);
          if (now - last < frameInterval) return;
          const elapsed = Math.min(0.067, (now - previous) / 1000);
          previous = now;
          last += Math.floor((now - last) / frameInterval) * frameInterval;
          intensity += (targetIntensity - intensity) * Math.min(1, elapsed * 5);
          paintStars(now, elapsed);
        };

        const stop = () => { cancelAnimationFrame(frame); frame = 0; };
        const start = () => {
          if (!frame && shouldAnimateStarfield(document.hidden, atmosphere)) {
            previous = performance.now();
            last = previous;
            frame = requestAnimationFrame(animateStarfield);
          }
        };

        addEventListener('scroll', updateIntensity, { passive: true });
        addEventListener('resize', updateIntensity);
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) stop();
          else start();
        });
        updateIntensity();
        start();
      }
    }
  </script>
</Layout>
