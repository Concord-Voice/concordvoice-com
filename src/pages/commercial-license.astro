---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import '@styles/marketing.css';
---

<Layout
  title="Commercial Licensing | Concord Voice"
  description="Commercial licensing for Concord Voice self-hosting."
>
  <Header />

  <main class="mx-auto w-full max-w-6xl px-6 pb-24 pt-10">
    <section class="mkt-hero">
      <p class="eyebrow text-gold">Licensing</p>
      <h1 class="display mkt-hero__title">Commercial licensing</h1>
      <p class="mkt-lead">Commercial self-hosting requires a Concord Voice commercial license.</p>
    </section>

    <section class="mkt-section">
      <p class="mkt-section__sub">
        Self-hosting is available now: see <a href="/self-hosting">how self-hosting works</a>. Personal and non-profit
        use is free. Use by a for-profit company or a government body needs a commercial license, apart from a 30-day
        internal evaluation that is not in production.
      </p>
      <div class="mkt-cta-row">
        <a href="mailto:contact-us@concordvoice.com?subject=Commercial%20licensing" class="btn btn-primary">Contact us about commercial licensing</a>
        <a href="/license" class="btn border border-white/20 hover:border-coral">Read the CVSL 1.0 →</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
