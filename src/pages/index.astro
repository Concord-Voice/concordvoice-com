---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Shot from '../components/Shot.astro';

// Homepage, "Proof in the Dark": show the product claim by claim, with download CTAs at
// the belief peaks. Reuses the global aurora/grain/star/fog atmosphere (Layout), the
// .rise/.reveal motion, and the .pill / .btn-primary components. Product screenshots are served
// from public/brand/shots/ (generated by scripts/optimize-shots.mjs) via <Shot>.

const stats = [
  { big: 'Drop in', label: 'Rooms, DMs & group calls' },
  { big: 'Your place', label: 'Themes, roles & channels' },
  { big: 'Private', label: 'End-to-end encryption, no data sales' },
  { big: 'Your rules', label: 'Hosted or self-hosted' },
];

---

<Layout
  title="Concord Voice | A Private Place for Your People"
  description="A private, voice-first community space for your people. Drop in to voice, video, and chat; make the space yours; and know your conversations stay private by design."
>
  <Header />

  <main id="home">
    <!-- ============ HERO, copy left / device right ============ -->
    <section class="pd-hero mx-auto max-w-6xl px-6 pb-10 pt-6">
      <div class="pd-hero__copy">
        <div class="pd-lockup rise" style="--d:0s">
          <div class="pd-lockup__copy">
            <span class="eyebrow text-gold">Voice, video &amp; chat</span>
          </div>
        </div>
        <h1 class="display rise pd-h1" style="--d:.12s">
          A private place for <span class="text-gradient">your people.</span>
        </h1>
        <p class="rise pd-sub text-mist" style="--d:.24s">
          Drop in, hang out, and make the space yours. Concord brings voice, video, and chat
          together, with privacy by design instead of a setting you have to hunt down.
        </p>
        <div class="rise pd-cta-row" style="--d:.36s">
          <a href="/download" class="btn btn-primary">Download the Beta</a>
          <a href="/app" class="btn border border-white/20 hover:border-coral">See how privacy works</a>
        </div>
      </div>

      <div class="pd-hero__device rise" style="--d:.48s">
        <div class="shot-hero">
          <Shot
            name="chat-hero"
            alt="The Concord Voice desktop app showing the Concord HQ server, the general channel with end-to-end-encrypted messages, and a members list."
            loading="eager"
            fetchpriority="high"
            sizes="(max-width: 900px) 92vw, 620px"
          />
        </div>
      </div>
    </section>

    <!-- ============ STATS, thin proof band under the hero ============ -->
    <section class="mx-auto max-w-5xl px-6 pb-20">
      <div class="pd-stats reveal">
        {stats.map((s) => (
          <div class="pd-stat">
            <div class="text-gradient font-mono pd-stat__big">{s.big}</div>
            <div class="eyebrow text-mist pd-stat__lab">{s.label}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- ============ MANIFESTO ============ -->
    <section id="why" class="reveal mx-auto max-w-4xl px-6 py-16 text-center">
      <p class="display text-2xl leading-snug sm:text-4xl">
        The internet has enough places that want your attention. <span class="text-gradient">We built one for your people.</span>
      </p>
    </section>

    <!-- ============ PROOF 1, E2E encryption (image left) ============ -->
    <section id="proof-encryption" class="proof reveal mx-auto max-w-6xl px-6 py-16">
      <div class="proof__grid">
        <div class="proof__media" style="--ry:6deg">
          <figure class="shot-card">
            <Shot name="server-dark" alt="A Concord Voice channel with the green 'Messages are encrypted end-to-end' bar visible at the bottom of the composer." sizes="(max-width: 900px) 92vw, 540px" />
            <figcaption class="shot-chip">AES-256-GCM</figcaption>
          </figure>
        </div>
        <div class="proof__copy">
          <p class="eyebrow text-gold">Encryption by default</p>
          <h2 class="display proof__h">Your conversations stay yours.</h2>
          <p class="text-mist proof__p">
            End-to-end encryption means only the people in a conversation can read its messages
            or hear its calls. Every message is encrypted before it leaves your device. There's no
            “private mode” to switch on, because there's no other mode.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ PROOF 2, Voice & video (image right) + CTA #1 ============ -->
    <section class="proof reveal mx-auto max-w-6xl px-6 py-16">
      <div class="proof__grid proof__grid--rev">
        <div class="proof__media" style="--ry:-6deg">
          <div class="shot-hero shot-hero--framed">
            <Shot name="voice-hero" alt="The Concord Voice voice-lounge: a 2-by-2 call grid of participants with gradient video tiles and call controls." sizes="(max-width: 900px) 92vw, 560px" />
            <span class="shot-chip shot-chip--float">7 audio tiers</span>
          </div>
        </div>
        <div class="proof__copy">
          <p class="eyebrow text-gold">Voice &amp; Video</p>
          <h2 class="display proof__h">The room is open. Come in when you're free.</h2>
          <p class="text-mist proof__p">
            Real-time encrypted calls, screen sharing, and channels make it easy to drop in and
            stay awhile. Choose the voice quality that fits your people, from bandwidth-light to
            virtually studio-grade, without putting someone else in the room with you.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ PROOF 3, Custom themes (live switcher) ============ -->
    <section class="proof reveal mx-auto max-w-6xl px-6 py-16">
      <div class="proof__grid">
        <div class="proof__media">
          <div class="theme-stage shot-card" data-theme-stage>
            <Shot name="server-dark"   class="theme-shot is-on" alt="Concord Voice in the default dark theme." sizes="(max-width: 900px) 92vw, 540px" />
            <Shot name="server-light"  class="theme-shot" alt="Concord Voice in the light theme." sizes="(max-width: 900px) 92vw, 540px" />
            <Shot name="server-candy"  class="theme-shot" alt="Concord Voice in the cotton-candy pastel theme." sizes="(max-width: 900px) 92vw, 540px" />
            <Shot name="server-hacker" class="theme-shot" alt="Concord Voice in the hacker terminal-green theme." sizes="(max-width: 900px) 92vw, 540px" />
          </div>
        </div>
        <div class="proof__copy">
          <p class="eyebrow text-gold">Custom Themes</p>
          <h2 class="display proof__h">A place should feel like your place.</h2>
          <p class="text-mist proof__p">
            Themes, colors, and emoji let a group make its shared space feel inhabited. The
            customization is what you see; the no-tracking, no-ads foundation is why it can stay
            yours.
          </p>
          <div class="theme-chips" role="group" aria-label="Preview a theme" data-theme-chips>
            <button type="button" class="pill" data-theme="0" aria-pressed="true">Dark</button>
            <button type="button" class="pill" data-theme="1" aria-pressed="false">Light</button>
            <button type="button" class="pill" data-theme="2" aria-pressed="false">Cotton Candy</button>
            <button type="button" class="pill" data-theme="3" aria-pressed="false">Hacker</button>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ PROOF 4, Self-host + security (layered) + CTA #2 ============ -->
    <section class="proof reveal mx-auto max-w-6xl px-6 py-16">
      <div class="proof__grid proof__grid--rev">
        <div class="proof__media" style="--ry:-6deg">
          <div class="stack">
            <figure class="shot-card stack__back" aria-hidden="true">
              <Shot name="privacy" alt="" sizes="(max-width: 900px) 80vw, 440px" />
            </figure>
            <figure class="shot-card stack__front">
              <Shot name="connect" alt="The Concord Voice connection selector, where you sign in to the hosted service or point the app at a server you run yourself." sizes="(max-width: 900px) 88vw, 500px" />
              <figcaption class="shot-chip">self-hosted</figcaption>
            </figure>
          </div>
        </div>
        <div class="proof__copy">
          <p class="eyebrow text-gold">Self-Hostable</p>
          <h2 class="display proof__h">Keep the space yours, all the way down.</h2>
          <p class="text-mist proof__p">
            Use Concord hosted, or run the entire platform on your own hardware and audit the
            source. Self-hosting unlocks every feature, and your community's data never has to
            touch our servers.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ FINAL CTA, faint dms-hero backdrop ============ -->
    <section class="pd-cta reveal">
      <div class="pd-cta__bg" aria-hidden="true">
        <Shot name="dms-hero" alt="" sizes="60vw" />
      </div>
      <div class="pd-cta__inner mx-auto max-w-2xl px-6 py-24 text-center">
        <p class="eyebrow text-gold">Open Beta live</p>
        <h2 class="display pd-cta__h">Open the door for your people.</h2>
        <p class="text-mist pd-cta__p">
          Download Concord Voice for macOS, Windows, or Linux and bring your people into a place
          that is private by design, welcoming to shape, and not funded by watching the people inside it.
        </p>
        <a href="/download" class="btn btn-primary pd-cta__btn">Download the Beta</a>
      </div>
    </section>
  </main>

  <Footer />

  <style is:global>
    /* ---- Shot framing language ---- */
    #home .shot-hero img { width: 100%; height: auto; display: block; aspect-ratio: 16 / 10; }
    /* Hero composites already carry their own purple backdrop + titlebar, feather their
       edges into --color-night so the app window emerges from the page (no fake chrome). */
    #home .shot-hero {
      position: relative;
      filter: drop-shadow(0 36px 70px color-mix(in oklab, var(--color-coral) 22%, transparent));
      -webkit-mask-image: radial-gradient(120% 120% at 50% 42%, #000 60%, transparent 96%);
      mask-image: radial-gradient(120% 120% at 50% 42%, #000 60%, transparent 96%);
    }
    /* a thin gold->coral hairline on the window's top edge echoes the brand mark */
    #home .shot-hero::before {
      content: ""; position: absolute; left: 8%; right: 8%; top: 0; height: 2px;
      background: linear-gradient(100deg, var(--color-gold), var(--color-coral));
      opacity: 0.7; border-radius: 2px; pointer-events: none;
    }
    #home .shot-hero--framed { -webkit-mask-image: none; mask-image: none; }
    #home .shot-hero--framed img { border-radius: 14px; }

    /* Raw screenshots get an explicit framed device card. */
    #home .shot-card {
      position: relative; margin: 0;
      border-radius: 14px; overflow: hidden;
      border: 1px solid color-mix(in oklab, var(--color-paper) 12%, transparent);
      box-shadow: 0 30px 60px -28px color-mix(in oklab, var(--color-coral) 40%, transparent),
                  0 2px 0 0 color-mix(in oklab, var(--color-paper) 6%, transparent) inset;
      background: var(--color-night);
    }
    #home .shot-card img { width: 100%; height: auto; display: block; aspect-ratio: 16 / 10; }

    /* Pinned label chip on a card. */
    #home .shot-chip {
      position: absolute; left: 12px; bottom: 12px;
      font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase;
      padding: 0.3rem 0.6rem; border-radius: 9999px;
      color: var(--color-gold);
      background: color-mix(in oklab, var(--color-night) 78%, #000);
      border: 1px solid color-mix(in oklab, var(--color-gold) 38%, transparent);
    }
    #home .shot-chip--float { left: auto; right: 14px; bottom: 14px; }

    /* ---- Hero layout ---- */
    #home .pd-hero { display: grid; gap: 2.5rem; align-items: center; }
    @media (min-width: 900px) { #home .pd-hero { grid-template-columns: 1fr 1.05fr; gap: 3rem; } }
    #home .pd-lockup { display: flex; align-items: center; gap: 0.7rem; margin-bottom: 1.1rem; }
    #home .pd-lockup img { height: 2.2rem; width: auto; filter: drop-shadow(0 0 18px color-mix(in oklab, var(--color-coral) 50%, transparent)); }
    #home .pd-lockup__copy { display: grid; gap: 0.28rem; }
    #home .pd-h1 { font-size: clamp(2.6rem, 6vw, 4.4rem); }
    #home .pd-sub { margin-top: 1.4rem; max-width: 34rem; font-size: 1.075rem; line-height: 1.6; }
    #home .pd-cta-row { margin-top: 1.8rem; display: flex; flex-wrap: wrap; gap: 0.75rem; }
    /* let the hero device bleed slightly past the column on wide screens for depth */
    @media (min-width: 1200px) { #home .pd-hero__device { margin-right: -3rem; } }

    /* ---- Stats band ---- */
    #home .pd-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px;
      background: color-mix(in oklab, var(--color-paper) 8%, transparent);
      border: 1px solid color-mix(in oklab, var(--color-paper) 8%, transparent);
      border-radius: 1rem; overflow: hidden; }
    @media (min-width: 720px) { #home .pd-stats { grid-template-columns: repeat(4, 1fr); } }
    #home .pd-stat { background: var(--color-night); padding: 1.4rem 1rem; text-align: center; }
    #home .pd-stat__big { font-size: clamp(1.7rem, 3vw, 2.4rem); line-height: 1; }
    #home .pd-stat__lab { margin-top: 0.5rem; }

    /* ---- Proof rows ---- */
    #home .proof__grid { display: grid; gap: 2.5rem; align-items: center; }
    @media (min-width: 900px) {
      #home .proof__grid { grid-template-columns: 1fr 1fr; gap: 3.5rem; }
      #home .proof__grid--rev .proof__media { order: 2; }
    }
    #home .proof__h { font-size: clamp(1.7rem, 3.4vw, 2.6rem); margin-top: 0.7rem; max-width: 16ch; }
    #home .proof__p { margin-top: 1rem; font-size: 1.05rem; line-height: 1.65; max-width: 40ch; }
    /* perspective tilt that straightens when the row scrolls in */
    #home .proof__media { perspective: 1400px; }
    #home .proof .shot-card, #home .proof .shot-hero--framed, #home .proof .stack {
      transform: rotateY(var(--ry, 0deg)); transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    #home .proof.in .shot-card, #home .proof.in .shot-hero--framed, #home .proof.in .stack { transform: rotateY(0deg); }

    /* ---- Theme switcher ---- */
    #home .theme-stage { aspect-ratio: 16 / 10; }
    /* <Shot> puts the class on the <img> itself, so size + object-fit live on .theme-shot
       directly (a `.theme-shot img` descendant selector would match nothing). */
    #home .theme-stage .theme-shot { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.32s ease; }
    #home .theme-stage .theme-shot.is-on { opacity: 1; }
    #home .theme-chips { margin-top: 1.4rem; display: flex; flex-wrap: wrap; gap: 0.5rem; }

    /* ---- Layered self-host cards ---- */
    #home .stack { position: relative; }
    #home .stack__front { position: relative; z-index: 2; width: 88%; }
    #home .stack__back {
      position: absolute; z-index: 1; right: 0; bottom: -1.6rem; width: 64%;
      transform: scale(0.96); opacity: 0.5; filter: saturate(0.85);
    }
    @media (max-width: 899px) { #home .stack__front { width: 100%; } #home .stack__back { display: none; } }

    /* ---- Final CTA with faint backdrop ---- */
    #home .pd-cta { position: relative; overflow: hidden; }
    #home .pd-cta__bg { position: absolute; inset: 0; z-index: 0; pointer-events: none;
      -webkit-mask-image: radial-gradient(80% 100% at 80% 50%, #000, transparent 75%);
      mask-image: radial-gradient(80% 100% at 80% 50%, #000, transparent 75%); }
    #home .pd-cta__bg img { position: absolute; right: -8%; top: 50%; transform: translateY(-50%);
      width: 64%; opacity: 0.12; filter: blur(2px) saturate(1.1); }
    #home .pd-cta__inner { position: relative; z-index: 1; }
    #home .pd-cta__h { font-size: clamp(2rem, 4vw, 3rem); margin-top: 0.6rem; }
    #home .pd-cta__p { margin-top: 1rem; }
    #home .pd-cta__btn { margin-top: 1.8rem; }

    /* Respect reduced motion: flatten tilt + make the theme swap instant.
       (The global block already neutralizes .rise/.reveal entrance movement.) */
    @media (prefers-reduced-motion: reduce) {
      #home .proof .shot-card, #home .proof .shot-hero--framed, #home .proof .stack { transform: none !important; transition: none !important; }
      #home .theme-stage .theme-shot { transition: none !important; }
    }
  </style>

  <script>
    // Live theme switcher (proof row 3), single-active aria-pressed, pure CSS cross-fade.
    // The four screenshots are pixel-aligned so the swap reads as the app recoloring in place.
    const stage = document.querySelector<HTMLElement>('[data-theme-stage]');
    const chipBox = document.querySelector<HTMLElement>('[data-theme-chips]');
    if (stage && chipBox) {
      const shots = Array.from(stage.querySelectorAll<HTMLElement>('.theme-shot'));
      const chips = Array.from(chipBox.querySelectorAll<HTMLButtonElement>('button[data-theme]'));
      const select = (idx: number) => {
        shots.forEach((s, i) => s.classList.toggle('is-on', i === idx));
        chips.forEach((c, i) => c.setAttribute('aria-pressed', i === idx ? 'true' : 'false'));
      };
      chips.forEach((c, i) => {
        c.addEventListener('click', () => select(i));
        c.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
            e.preventDefault();
            const next = (i + (e.key === 'ArrowRight' ? 1 : chips.length - 1)) % chips.length;
            chips[next].focus();
            select(next);
          }
        });
      });
    }

  </script>
</Layout>
