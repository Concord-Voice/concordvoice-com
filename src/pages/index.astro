---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Each feature pill shows its blurb in the panel below the row — on hover/focus (preview)
// or click (pins it; click again to clear). One panel, so nothing sticks open.
const features = [
  { label: 'End-to-End Encrypted', blurb: 'AES-256-GCM on every message, with 4096-bit RSA key wrapping. We can’t read your conversations — the math won’t allow it.' },
  { label: 'Voice & Video', blurb: 'Real-time encrypted calls, screen sharing, and channels — a full modern platform, with nothing listening in.' },
  { label: 'Self-Hostable', blurb: 'Run the entire platform on your own hardware and audit the source. Your data never has to touch our servers.' },
  { label: 'Open-Source Path', blurb: 'Under the Concord Voice Source License, the codebase converts to AGPL-3.0 automatically — so it outlives us.' },
  { label: '7 Audio Tiers', blurb: 'Seven voice-quality tiers, from bandwidth-light to studio-grade — clear, private voice is free for everyone; studio-grade fidelity comes with premium.' },
  { label: 'Custom Themes', blurb: 'Make it yours — custom themes, colors, and emoji — without the surveillance baked into other platforms.' },
  { label: 'No Ads. Ever.', blurb: 'No ads, no trackers, no data sales. Funded by subscriptions, not by profiling you. You’re the user, not the product.' },
];

const stats = [
  { big: 'AES-256', label: 'Message Encryption' },
  { big: '4096-bit', label: 'Key Wrapping' },
  { big: '0', label: 'Messages We Can Read' },
  { big: '0', label: 'Compromises' },
];
---

<Layout>
  <Header />

  <main>
    <!-- ============ HERO ============ -->
    <section class="mx-auto max-w-6xl px-6 pb-24 pt-12 text-center">
      <img
        src="/brand/symbol.png"
        alt=""
        width="84"
        height="84"
        class="rise mx-auto mb-8 h-20 w-auto"
        style="--d:0s; filter: drop-shadow(0 0 34px color-mix(in oklab, var(--color-coral) 55%, transparent));"
      />
      <p class="eyebrow eyebrow-hero rise text-gold" style="--d:.1s">Open Beta — June 21st, 2026</p>

      <h1 class="display rise mt-5 text-5xl sm:text-7xl" style="--d:.2s">
        Concord <span class="text-gradient">Voice</span>
      </h1>

      <p class="rise mx-auto mt-7 max-w-2xl text-lg text-mist sm:text-xl" style="--d:.32s">
        A communications platform where your messages are encrypted before they leave your device.
        Where clear, private voice is free for everyone. Where you can run the
        whole thing on your own hardware — with every feature unlocked.
      </p>

      <div class="rise mt-9 flex flex-wrap items-center justify-center gap-3" style="--d:.44s">
        <a
          href="https://www.kickstarter.com/projects/concord-mark/concord-voice"
          target="_blank"
          rel="noopener noreferrer"
          class="ks-btn"
        >
          <img src="/brand/kickstarter-k-white.png" alt="" />
          <span>Follow on Kickstarter</span>
        </a>
        <a href="#why" class="btn border border-white/20 hover:border-coral">Why Concord</a>
      </div>

      <ul class="rise mt-12 flex flex-wrap items-center justify-center gap-3" style="--d:.56s">
        {features.map((f) => (
          <li>
            <button type="button" class="pill" data-blurb={f.blurb} aria-pressed="false">{f.label}</button>
          </li>
        ))}
      </ul>
      <p class="pill-blurb rise is-hint" id="pill-blurb" aria-live="polite" data-hint="Tap a feature to see what it means." style="--d:.62s">Tap a feature to see what it means.</p>
    </section>

    <!-- ============ MANIFESTO ============ -->
    <section id="why" class="reveal mx-auto max-w-4xl px-6 py-20 text-center">
      <blockquote class="display text-2xl leading-snug sm:text-4xl">
        “We got tired of telling people to protect their data while watching the tools we used every
        day do the opposite. <span class="text-gradient">So we built the alternative.</span>”
      </blockquote>
      <p class="eyebrow mt-6 text-mist">— The Concord Voice Team</p>
    </section>

    <!-- ============ STATS ============ -->
    <section class="mx-auto max-w-7xl px-6 py-12">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          stats.map((s, i) => (
            <div
              class="reveal rounded-2xl border border-white/10 bg-white/5 p-8 text-center"
              style={`transition-delay:${i * 90}ms`}
            >
              <div class="text-gradient font-mono text-4xl sm:text-5xl">{s.big}</div>
              <div class="eyebrow mt-3 text-mist">{s.label}</div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ============ KICKSTARTER ============ -->
    <section id="kickstarter" class="reveal mx-auto max-w-2xl px-6 py-24 text-center">
      <p class="eyebrow text-gold">Pre-Launch</p>
      <h2 class="display mt-3 text-3xl sm:text-5xl">We're Launching on Kickstarter</h2>
      <p class="mt-4 text-mist">
        Follow the campaign to be notified the moment it goes live — and help bring private,
        self-hostable communication to everyone.
      </p>
      <a
        href="https://www.kickstarter.com/projects/concord-mark/concord-voice"
        target="_blank"
        rel="noopener noreferrer"
        class="ks-btn mt-8"
      >
        <img src="/brand/kickstarter-k-white.png" alt="" />
        <span>Follow on Kickstarter</span>
      </a>
      <p class="mt-4 text-xs text-mist">Backing is handled on Kickstarter, which requires a free Kickstarter account.</p>
    </section>
  </main>

  <Footer />

  <script>
    // Feature pills → one blurb panel below the row. Hover/focus previews; click pins
    // (and toggles off). A single panel means nothing "sticks" — this replaces the old
    // per-pill tooltip that stayed open after a click.
    const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('.pill[data-blurb]'));
    const panel = document.getElementById('pill-blurb');
    if (pills.length && panel) {
      const hint = panel.dataset.hint ?? '';
      let pinned: HTMLButtonElement | null = null;
      const show = (text: string | null) => {
        panel.textContent = text || hint;
        panel.classList.toggle('is-hint', !text);
      };
      const restore = () => show(pinned ? pinned.dataset.blurb! : null);
      pills.forEach((p) => {
        p.addEventListener('mouseenter', () => show(p.dataset.blurb!));
        p.addEventListener('focus', () => show(p.dataset.blurb!));
        p.addEventListener('mouseleave', restore);
        p.addEventListener('blur', restore);
        p.addEventListener('click', () => {
          const wasPinned = pinned === p;
          if (pinned) { pinned.classList.remove('is-active'); pinned.setAttribute('aria-pressed', 'false'); }
          pinned = wasPinned ? null : p;
          if (pinned) { pinned.classList.add('is-active'); pinned.setAttribute('aria-pressed', 'true'); }
          restore();
        });
      });
    }
  </script>
</Layout>
