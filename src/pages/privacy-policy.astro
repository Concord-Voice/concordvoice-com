---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
// Canonical repo markdown rendered directly, same pattern as /terms.
import { Content } from '../legal/privacy-policy.md';
---

<Layout title="Privacy Policy | Concord Voice" description="Concord Voice Privacy Policy.">
  <Header />
  <main class="mx-auto max-w-3xl px-6 py-16">
    <article class="legal">
      <Content />
    </article>
    <p class="mt-12 text-sm text-mist">
      ← <a href="/" class="text-coral hover:text-gold">Back to home</a>
    </p>
  </main>
  <Footer />
</Layout>
