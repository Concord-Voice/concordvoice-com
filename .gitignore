# dependencies
node_modules/

# build output
dist/
.astro/

# design reference (large binaries / screenshots — not source)
_design-reference/

# cloudflare / local env
.wrangler/
.dev.vars
*.log

# claude code local config (preview launcher, session state) — not project source.
# Exception: shared skills/agents are committed real-file copies synced from the
# dev-tooling Master (scripts/sync-shared.sh) — Claude Code can't load symlinked skills.
.claude/*
!.claude/skills/
!.claude/agents/

# draft pages — work-in-progress (e.g. Squarespace migrations). Kept off the
# public repo, and stripped from the production build by astro.config.mjs so
# they can never be published. Preview locally via `npm run dev` (/drafts/*).
src/pages/drafts/

# os
.DS_Store
