# dependencies
node_modules/

# build output
dist/
.astro/

# design reference (large binaries / screenshots — not source)
_design-reference/

# cloudflare / local env
.wrangler/
.dev.vars
*.log

# claude code local config (preview launcher, session state) — not project source.
# Exception: shared skills/agents are committed real-file copies synced from the
# dev-tooling Master (scripts/sync-shared.sh) — Claude Code can't load symlinked skills.
.claude/*
!.claude/skills/
!.claude/agents/

# draft pages — stripped from the production build by astro.config.mjs so they
# can never be published. Most scratch drafts stay local; enterprise + blog are
# preserved in git while unpublished.
src/pages/drafts/*
!src/pages/drafts/enterprise-msp.astro
!src/pages/drafts/blog/
!src/pages/drafts/blog/**
src/pages/drafts/blog/_HANDOFF.md

# os
.DS_Store
